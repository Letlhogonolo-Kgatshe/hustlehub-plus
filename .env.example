# Copy to .env in the repo root before starting the database.
# Docker Compose reads it to create the MongoDB user on first run.

MONGO_ROOT_USERNAME=hustlehub

# generate your own:
#   node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
MONGO_ROOT_PASSWORD=replace_with_a_generated_password

# Application user created by "npm run db:create-user" in the api folder.
# The API connects as this user, which has readWrite on the hustlehub database only.
MONGO_APP_USERNAME=hustlehub_app
MONGO_APP_PASSWORD=replace_with_a_generated_password
