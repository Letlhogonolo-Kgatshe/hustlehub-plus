            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{client2Email}}\",\n  \"password\": \"{{testPassword}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('the second client can log in', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('A token is returned', () => pm.expect(body).to.have.property('token'));",
                  "pm.collectionVariables.set('client2Token', body.token);"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "6. Role and ownership rules",
      "description": "Role-based access control. Nobody may act outside their role, and no freelancer may touch gigs belonging to another freelancer.",
      "item": [
        {
          "name": "Log in as admin",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (!pm.variables.get('adminEmail') || !pm.variables.get('adminPassword')) {",
                  "  console.log('Admin checks skipped: pass adminEmail and adminPassword with --env-var or --global-var to run them');",
                  "  pm.execution.skipRequest();",
                  "}"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('The admin can log in', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('The account has the admin role', () => pm.expect(body.user.role).to.eql('admin'));",
                  "pm.collectionVariables.set('adminToken', body.token);"
                ]
              }
            }
          ],
          "description": "The admin account comes from \"npm run seed:admin\". Its email and password are never saved in this file. Pass them to Newman with --env-var or --global-var (or a Postman environment) to run the four admin checks; without them those requests are skipped and the rest of the suite still runs."
        },
        {
          "name": "Admin lists users -> 200",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/users",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "users"
              ]
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (!pm.variables.get('adminEmail') || !pm.variables.get('adminPassword')) {",
                  "  console.log('Admin checks skipped: pass adminEmail and adminPassword with --env-var or --global-var to run them');",
                  "  pm.execution.skipRequest();",
                  "}"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Users are listed', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('The list is paged', () => { pm.expect(body.page).to.eql(1); pm.expect(body.limit).to.be.at.most(50); pm.expect(body.total).to.be.at.least(body.users.length); });",
                  "pm.test('Each user shows only id, email, role and createdAt', () => body.users.forEach((u) => pm.expect(Object.keys(u).sort()).to.eql(['createdAt', 'email', 'id', 'role'])));",
                  "pm.test('No password hash anywhere', () => pm.expect(pm.response.text()).to.not.match(/passwordHash|\\$2[aby]\\$/));",
                  "pm.test('The new client is in the list', () => pm.expect(body.users.map((u) => u.email)).to.include(pm.collectionVariables.get('client2Email')));"
                ]
              }
            }
          ]
        },
        {
          "name": "Logout ends the session -> 200",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{client2Token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/logout",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "logout"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Logged out', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ],
          "description": "Logout raises the account's token version on the server, so every token issued before it stops working."
        },
        {
          "name": "The logged-out token is refused -> 401",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{client2Token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/bookings",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "bookings"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('The old token no longer works', () => pm.response.to.have.status(401));",
                  "pm.test('No bookings are returned', () => pm.expect(pm.response.json()).to.not.have.property('bookings'));"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
