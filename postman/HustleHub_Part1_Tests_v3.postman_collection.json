                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{testEmail}}\",\n  \"password\": \"{{testPassword}}\",\n  \"role\": \"{{testRole}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "register"
              ]
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('testEmail', `testuser+${Date.now()}@example.com`);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 201', () => pm.response.to.have.status(201));",
                  "pm.test('Response does not contain password', () => {",
                  "  const body = pm.response.json();",
                  "  pm.expect(JSON.stringify(body)).to.not.include('password');",
                  "});",
                  "pm.test('Response contains user id and email', () => {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.user).to.have.property('id');",
                  "  pm.expect(body.user).to.have.property('email');",
                  "});",
                  "",
                  "pm.test('Account is created with the requested role', () => {",
                  "  pm.expect(pm.response.json().user.role).to.eql(pm.collectionVariables.get('testRole'));",
                  "});"
                ]
              }
            }
          ],
          "response": []
        },
