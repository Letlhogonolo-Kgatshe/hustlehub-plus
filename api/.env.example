# Copy to api/.env and fill in. api/.env is gitignored.

PORT=5000

CLIENT_ORIGIN=http://localhost:5173,http://localhost:5174

AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=50
BOOKING_RATE_LIMIT_WINDOW_MS=600000
BOOKING_RATE_LIMIT_MAX=20

# at least 32 characters, generate your own:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace_with_a_generated_random_string

# local certificate pair, relative to the api folder. Make them with mkcert.
SSL_KEY_PATH=./certs/localhost-key.pem
SSL_CERT_PATH=./certs/localhost.pem

# The API connects as the application user, not root. Create it once with
# "npm run db:create-user" in the api folder; it has readWrite on hustlehub only.
# Username and password must match MONGO_APP_* in the repository root .env.
MONGO_URI=mongodb://hustlehub_app:your_app_password_here@127.0.0.1:27017/hustlehub?authSource=hustlehub

# admin account created by "npm run seed:admin". Admin cannot be chosen on the
# register form. Use a strong password and never commit the real one.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace_with_a_strong_password

# account lockout: this many failed logins in a row lock the account for this many minutes
LOCKOUT_MAX_ATTEMPTS=5
LOCKOUT_MINUTES=15

# logging: error, warn, info or debug
LOG_LEVEL=info

# Optional cloud logging platform (for example Better Stack). Leave both empty to log
# to the console only. Copy the ingesting URL and source token from the platform's
# dashboard into api/.env. NEVER put the real token in this file.
LOG_SINK_URL=
LOG_SINK_TOKEN=
